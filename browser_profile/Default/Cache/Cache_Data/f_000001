<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Manager Dashboard - Luanda Feeds Centre</title>
    
    <link rel="stylesheet" href="/static/css/style.css" />
    <style>
      :root {
        --bg-cream: #fdf5e6;
        --text-black: #0a0a0a;
        --accent-cyan: #00ffff;
        --accent-cyan-dark: #00cccc;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu,
          sans-serif;
        background-color: var(--bg-cream);
        color: var(--text-black);
        min-height: 100vh;
      }

      .navbar {
        background-color: var(--text-black);
        padding: 15px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .navbar-brand {
        color: var(--accent-cyan);
        font-size: 1.5rem;
        font-weight: bold;
        text-decoration: none;
      }

      .navbar-menu {
        display: flex;
        align-items: center;
        gap: 20px;
      }

      .navbar-right {
        display: flex;
        align-items: center;
        gap: 15px;
      }

      .hamburger {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        cursor: pointer;
        gap: 5px;
        width: 44px;
        height: 44px;
        background: transparent;
        border: 2px solid var(--accent-cyan);
        border-radius: 8px;
        padding: 8px;
        transition: all 0.3s ease;
      }

      .hamburger-line {
        width: 22px;
        height: 3px;
        background-color: var(--accent-cyan);
        transition: all 0.3s ease;
        border-radius: 2px;
      }

      .hamburger:hover {
        background-color: var(--accent-cyan);
      }

      .hamburger:hover .hamburger-line {
        background-color: var(--text-black);
      }

      .dropdown {
        position: relative;
        display: inline-block;
      }

      .dropdown-content {
        display: none;
        position: absolute;
        right: 0;
        top: 100%;
        background-color: var(--text-black);
        min-width: 220px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
        border-radius: 12px;
        z-index: 1000;
        overflow: hidden;
        margin-top: 8px;
      }

      .dropdown-content.active {
        display: block;
      }

      .dropdown-header {
        padding: 15px 20px;
        background-color: rgba(0, 255, 255, 0.1);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      }

      .dropdown-item {
        color: var(--accent-cyan);
        text-decoration: none;
        padding: 12px 20px;
        display: flex;
        align-items: center;
        gap: 12px;
        transition: all 0.3s ease;
      }

      .dropdown-item:hover {
        background-color: var(--accent-cyan);
        color: var(--text-black);
      }

      .dropdown-icon {
        font-size: 1.1rem;
        width: 20px;
        text-align: center;
      }

      .dropdown-divider {
        height: 1px;
        background-color: rgba(255, 255, 255, 0.1);
        margin: 5px 0;
      }

      .logout-item {
        color: #ff6b6b;
      }

      .logout-item:hover {
        background-color: #ff6b6b;
        color: white;
      }

      .nav-links {
        display: flex;
        gap: 15px;
        align-items: center;
      }

      .nav-link {
        color: var(--accent-cyan);
        text-decoration: none;
        padding: 8px 16px;
        border-radius: 24px;
        transition: all 0.3s ease;
      }

      .nav-link:hover {
        background-color: var(--accent-cyan);
        color: var(--text-black);
      }

      .user-welcome {
        color: #fff;
        font-size: 0.9rem;
      }

      @media (max-width: 768px) {
        .dropdown-content {
          position: fixed;
          top: 60px;
          right: 10px;
          left: 10px;
          max-width: 300px;
          margin: 0 auto;
        }
      }

      .main-content {
        padding: 20px;
        max-width: 1400px;
        margin: 0 auto;
      }

      .card {
        background: #fff;
        border-radius: 24px;
        padding: 25px;
        margin-bottom: 20px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
      }

      .card-title {
        font-size: 1.3rem;
        font-weight: bold;
        margin-bottom: 20px;
        color: var(--text-black);
      }

      .btn {
        display: inline-block;
        padding: 10px 24px;
        border-radius: 24px;
        text-decoration: none;
        border: 2px solid var(--accent-cyan);
        background-color: var(--accent-cyan);
        color: var(--text-black);
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
      }

      .btn:hover {
        background-color: var(--accent-cyan-dark);
        transform: translateY(-2px);
      }

      .btn-outline {
        background-color: transparent;
        color: var(--text-black);
      }

      .btn-outline:hover {
        background-color: var(--accent-cyan);
      }

      .btn-danger {
        background-color: #ff4444;
        border-color: #ff4444;
        color: #fff;
      }

      .btn-danger:hover {
        background-color: #cc0000;
      }

      .btn-sm {
        padding: 6px 16px;
        font-size: 0.85rem;
      }

      table {
        width: 100%;
        border-collapse: collapse;
      }

      th,
      td {
        padding: 12px 15px;
        text-align: left;
        border-bottom: 1px solid #eee;
      }

      th {
        background-color: var(--accent-cyan);
        font-weight: 600;
        color: var(--text-black);
      }

      tr:hover {
        background-color: #f5f5f5;
      }

      .low-stock-row {
        background-color: #ffebee !important;
        border-left: 4px solid #ff4444;
      }

      .form-group {
        margin-bottom: 15px;
      }

      .form-group label {
        display: block;
        margin-bottom: 5px;
        font-weight: 600;
      }

      .form-control {
        width: 100%;
        padding: 12px 16px;
        border: 2px solid #ddd;
        border-radius: 12px;
        font-size: 1rem;
        transition: border-color 0.3s;
      }

      .form-control:focus {
        outline: none;
        border-color: var(--accent-cyan);
      }

      .alert {
        padding: 15px 20px;
        border-radius: 12px;
        margin-bottom: 20px;
      }

      .alert-success {
        background-color: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
      }

      .alert-error {
        background-color: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
      }

      .search-bar {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
      }

      .search-bar input {
        flex: 1;
        padding: 12px 16px;
        border: 2px solid #ddd;
        border-radius: 24px;
        font-size: 1rem;
      }

      .search-bar input:focus {
        outline: none;
        border-color: var(--accent-cyan);
      }

      .stat-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
      }

      .stat-card {
        background: #fff;
        border-radius: 24px;
        padding: 25px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        text-align: center;
      }

      .stat-card h3 {
        font-size: 0.9rem;
        color: #666;
        margin-bottom: 10px;
      }

      .stat-card .value {
        font-size: 2.5rem;
        font-weight: bold;
        color: var(--accent-cyan);
      }

      .status-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 0.8rem;
        font-weight: 600;
      }

      .status-ok {
        background-color: #d4edda;
        color: #155724;
      }

      .status-low {
        background-color: #ffebee;
        color: #c62828;
      }

      .pagination {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin-top: 20px;
      }

      .pagination a {
        padding: 8px 16px;
        border: 1px solid #ddd;
        border-radius: 12px;
        text-decoration: none;
        color: var(--text-black);
      }

      .pagination a.active,
      .pagination a:hover {
        background-color: var(--accent-cyan);
        border-color: var(--accent-cyan);
      }

      .action-buttons {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 20px;
      }

      .grid-2 {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
      }

      .empty-state {
        text-align: center;
        padding: 40px;
        color: #666;
      }

      @media (max-width: 768px) {
        .hamburger {
          display: flex;
        }

        .nav-links {
          display: none;
          position: absolute;
          top: 60px;
          left: 0;
          right: 0;
          background-color: var(--text-black);
          flex-direction: column;
          padding: 20px;
          gap: 10px;
        }

        .nav-links.active {
          display: flex;
        }

        .stat-cards {
          grid-template-columns: 1fr;
        }
      }

      /* Print styles */
      @media print {
        .navbar,
        .btn,
        .no-print {
          display: none !important;
        }

        body {
          background: #fff;
        }

        .main-content {
          padding: 0;
          max-width: 100%;
        }

        @page {
          size: A4;
          margin: 1cm;
        }
      }
    </style>
    
  </head>
